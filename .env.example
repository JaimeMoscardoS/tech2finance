# Tech2Finance: variables de entorno del servidor (referencia).
# La aplicación NO carga este archivo automáticamente: exporta las variables en la
# terminal antes de arrancar (ver README, sección «Configuración»).
# Todas son opcionales. Nunca subas claves reales a Git.

# Tutor y análisis con Claude. Sin clave, el tutor funciona con reglas locales.
ANTHROPIC_API_KEY=
# T2F_ANTHROPIC_MODEL=claude-sonnet-5-5
# T2F_TUTOR_PROVIDER=anthropic        # anthropic | server_rules (auto: anthropic si hay clave)
# T2F_ANALYSIS_PROVIDER=anthropic     # demo (por defecto) | anthropic

# Dictado por voz del servidor (ElevenLabs). Sin clave: reconocimiento local del navegador.
ELEVENLABS_API_KEY=
# T2F_SPEECH_PROVIDER=elevenlabs      # elevenlabs | browser_local

# Contexto de mercado en la pausa antipánico (archivo público del BCE). «off» lo desactiva.
# T2F_NEWS_PROVIDER=ecb_archive

# Puertos e intérprete Python del lanzador `npm run dev:full`
# T2F_BACKEND_PORT=8000
# T2F_FRONTEND_PORT=5173
# T2F_PYTHON=

# Entidad mostrada por el frontend (demo, caixabank, bbva, santander). Se lee al arrancar Vite.
# VITE_BANK_ID=demo
